APP_NAME=NitiOS
APP_ENV=development
APP_HOST=0.0.0.0
APP_PORT=8000
LOG_LEVEL=INFO
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_DEFAULT_MODEL=qwen2.5:3b
# Shared Ollama HTTP connect/read/write/pool timeout in seconds.
OLLAMA_TIMEOUT_SECONDS=60
# Agent and MCP tools. Server definitions live in backend/mcp_servers.json.
MCP_TIMEOUT_SECONDS=30
AGENT_MAX_STEPS=6
# Optional: enables the GitHub MCP server (read-only). Create a fine-grained token at
# https://github.com/settings/personal-access-tokens with read access to the repos you want.
GITHUB_PERSONAL_ACCESS_TOKEN=
