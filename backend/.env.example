APP_NAME=Setu
APP_ENV=development
APP_HOST=0.0.0.0
APP_PORT=8000
LOG_LEVEL=INFO
# Which model provider answers chats: "ollama" (local, free), "gemini" (Google, cloud, free tier)
# or "anthropic" (Claude, cloud, paid).
LLM_PROVIDER=ollama
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_DEFAULT_MODEL=qwen2.5:7b
# Seconds to wait for Ollama. Local models on a CPU can need several minutes, so keep this generous.
OLLAMA_TIMEOUT_SECONDS=300
# Agent and MCP tools. Server definitions live in backend/mcp_servers.json.
MCP_TIMEOUT_SECONDS=30
AGENT_MAX_STEPS=6
# Browser origins allowed to call the API directly (JSON list). The Vite dev proxy does not need this.
CORS_ORIGINS=["http://localhost:5173","http://127.0.0.1:5173"]
# Claude (used when LLM_PROVIDER=anthropic). Create a key at https://console.anthropic.com/settings/keys
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5-5
ANTHROPIC_MAX_TOKENS=4096
# Gemini (used when LLM_PROVIDER=gemini). Create a free key at https://aistudio.google.com/apikey
# It stays free unless you enable billing on the key's Google Cloud project.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3-flash-preview
# How hard the model thinks before answering: minimal, low, medium or high. Lower is faster.
GEMINI_REASONING_EFFORT=low

# --- Accounts ---
# Where the browser opens Setu. OAuth callback URLs are built from this.
PUBLIC_URL=http://localhost:5173
# Encrypts stored GitHub tokens. Generate one with:
#   python -c "import secrets; print(secrets.token_urlsafe(32))"
# Changing it disconnects every connected account.
SECRET_KEY=
# Optional: only these Google accounts may sign in (JSON list). Empty allows any Google account.
ALLOWED_EMAILS=[]
# Sign in with Google. Create an OAuth client (type "Web application") at
# https://console.cloud.google.com/apis/credentials with this authorized redirect URI:
#   http://localhost:5173/api/v1/auth/google/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Connect GitHub. Create an OAuth App at https://github.com/settings/developers with callback URL:
#   http://localhost:5173/api/v1/connections/github/callback
# Setu's GitHub tools only read, but GitHub has no read-only scope for private repos.
# Use "read:user public_repo" instead of "read:user repo" to limit Setu to public repositories.
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
GITHUB_OAUTH_SCOPES=read:user repo
