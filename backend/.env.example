APP_NAME=Setu
APP_ENV=development
APP_HOST=0.0.0.0
APP_PORT=8000
LOG_LEVEL=INFO
# Which model provider answers chats: "ollama" (local, free) or "anthropic" (Claude, cloud).
LLM_PROVIDER=ollama
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_DEFAULT_MODEL=qwen2.5:7b
# Seconds to wait for Ollama. Local models on a CPU can need several minutes, so keep this generous.
OLLAMA_TIMEOUT_SECONDS=300
# Agent and MCP tools. Server definitions live in backend/mcp_servers.json.
MCP_TIMEOUT_SECONDS=30
AGENT_MAX_STEPS=6
# Optional: enables the GitHub MCP server (read-only). Create a fine-grained token at
# https://github.com/settings/personal-access-tokens with read access to the repos you want.
GITHUB_PERSONAL_ACCESS_TOKEN=
# Browser origins allowed to call the API directly (JSON list). The Vite dev proxy does not need this.
CORS_ORIGINS=["http://localhost:5173","http://127.0.0.1:5173"]
# Claude (used when LLM_PROVIDER=anthropic). Create a key at https://console.anthropic.com/settings/keys
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5-5
ANTHROPIC_MAX_TOKENS=4096
